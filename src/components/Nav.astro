---
const { active } = Astro.props as { active?: string };

const links = [
  { href: "/", label: "work1" },
  { href: "/work02", label: "work2" },
  { href: "/about", label: "about" },
];
---

<nav class="fixed top-3 left-4 z-40 flex gap-3 text-[16px] tracking-wide font-sans">
  {links.map((link) => (
    <a
      href={link.href}
      class="transition-colors hover:text-white"
      style={active === link.label ? "color: #22c55e;" : "color: rgba(255,255,255,0.8);"}
    >
      {link.label}
    </a>
  ))}
</nav>
