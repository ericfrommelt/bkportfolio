---
import { Image } from "astro:assets";
import chain from "../assets/about/33.png";
---

<section class="px-6 md:px-10 max-w-6xl mx-auto pt-2 md:pt-2">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
    <h1 class="md:col-span-7 font-serif text-white text-[44px] sm:text-5xl md:text8xl leading-[1.05] tracking-tight md:pt-16">
      VISUAL DEVELOPMENT.<br />3D ARTIST.<br />CREATIVE LEAD.
    </h1>

    <div class="md:col-span-5 md:pt-6 text-[16px] leading-[1.6] text-white/85 font-sans space-y-4">
      <p>
        Bora Kang is a multidisciplinary designer based in LA and NY, specializing in visual development, stylized 3D artwork, and interactive experiences.
      </p>
      <ul class="space-y-1">
        <li>
          LinkedIn:
          <a
            href="https://linkedin.com/in/borakang/"
            class="underline decoration-white/40 underline-offset-2 hover:decoration-white"
            target="_blank"
            rel="noreferrer"
          >linkedin.com/in/borakang/</a>
        </li>
        <li>
          Mail:
          <a
            href="mailto:borakangwork@gmail.com"
            class="underline decoration-white/40 underline-offset-2 hover:decoration-white"
          >borakangwork@gmail.com</a>
        </li>
      </ul>

      <div class="border border-white mt-4 p-4 space-y-2">
        <p><span class="font-bold">FEATURED FRANCHISES & PARTNERS:  </span><br />Nintendo, Minecraft, Overwatch, Apple, Roblox, McDonald's</p>
        <p><span class="font-bold">SELECTED GAME PROJECTS:</span><br />Dragon Age (2024), Dead Space (2023), Apex Legends (2021)</p>
        <p><span class="font-bold">SELECTED CLIENTS:</span><br />Delta, AMEX, BoA, Accenture, Verifone</p>
      </div>
    </div>
  </div>

  <div class="mt-6 md:mt-8 flex justify-center pb-20">
    <Image
      src={chain}
      alt="Chain illustration"
      class="w-full max-w-3xl h-auto"
      loading="eager"
    />
  </div>
</section>
