---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import add1 from "../assets/Work2/add1.gif";
import add2 from "../assets/Work2/add2.gif";
import more from "../assets/Work2/more.png";

// Default password: "borak1"
// To change, run in any browser console:
//   crypto.subtle.digest("SHA-256", new TextEncoder().encode("YOUR_PASSWORD"))
//     .then(b => console.log([...new Uint8Array(b)].map(x=>x.toString(16).padStart(2,"0")).join("")))
const PASSWORD_HASH =
  "a1b04abed61b2233d334715516ff4a71ecbf8b4602e976db3b7339a4555ab369";

const all = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/Work2/*.{jpg,JPG,jpeg,png,PNG,gif,GIF,webp}",
  { eager: true },
);

const naturalSort = (a: string, b: string) =>
  a.localeCompare(b, undefined, { numeric: true, sensitivity: "base" });

const images = Object.entries(all)
  .sort(([a], [b]) => naturalSort(a, b))
  .map(([, mod]) => mod.default);

const youtubeIds = [
  "VcOeBW92ioU",
  "IeMZVSQKTL0",
  "IZCFqFUEEs4",
  "riFGMOSZs_8",
];
---

<Layout title="Work 02 — Bora Kang" active="work2">
  <section
    id="gate"
    class="fixed inset-0 z-30 bg-black flex items-center justify-center px-6"
  >
    <form id="gate-form" class="w-full max-w-sm space-y-5 text-center">
      <p class="text-white/70 text-[18px] font-sans">
        Enter password to view this work.
      </p>
      <p class="text-[18px] font-sans">pw: <span class="text-green-500">borak1</span></p>
      <input
        type="password"
        id="gate-input"
        autocomplete="current-password"
        autofocus
        class="w-full bg-transparent border-b border-white/30 px-1 py-2 text-white text-base font-sans focus:outline-none focus:border-white"
      />
      <p
        id="gate-error"
        class="text-red-500 text-xs font-sans h-4"
        aria-live="polite"
      >
      </p>
      <button
        type="submit"
        class="font-sans text-base tracking-widest uppercase text-white/80 hover:text-white border border-white/30 hover:border-white px-6 py-2 transition-colors cursor-pointer"
      >
        Enter
      </button>
    </form>
  </section>

<section
  id="gate-content"
  hidden
class="px-2 max-w-6xl mx-auto pt-2 pb-24"
>
    <p class="font-sans text-[15px] tracking-normal uppercase text-white/40 mb-2">
      WORK 02: SELECTED CLIENT WORK
    </p>
<!-- 섹션 4: 유튜브 영상들 (맨 위) -->
<div>
  <h2 class="font-serif text-1xl md:text-3xl lg:text-4xl text-white mb-0 leading-[0.9]">
    Franchise Game Director — <br /> Global Licensed Game Productions
  </h2>
  <p class="pt-4 text-[16px] md:text-[18px]"><span class="font-bold">Minecraft, Apple Arcade & AAA Cross-Platform Titles </span> <br /> Directed creative approvals for Sanrio IP across multiple AAA and cross-platform game collaborations. <br / > Oversaw game concept, design, development, audio, and marketing assets, ensuring franchise integrity throughout development and global launch.<br /><span class="font-bold"><br /> Nintendo Switch Hello Kitty Island Adventure, Overwatch, Minecraft, and Roblox</span> <br /><br /></p>
</div>
<div class="space-y-6">
  {youtubeIds.map((id) => (
    <div class="aspect-video w-full">
      <iframe
        class="w-full h-full yt-lazy"
        data-src={`https://www.youtube.com/embed/${id}`}
        title="YouTube video player"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>
    </div>
  ))}
</div>

<!-- 섹션 1: Dragon Age -->
<div class="mt-16">
  <h2 class="font-serif text-1xl md:text-3xl lg:text-4xl text-white mb-0 leading-[0.9]">
    3D Visual Development — <br /> Concept to Final Render
  </h2>
  <p class="pt-4 text-[16px] md:text-[18px]"><span class="font-bold">3D Visual Artist for [Dragon Age: The Veilguard] (EA) </span>— Sole creator of the game's logo, promotional environment visuals, and VFX, <br />
    from early concept through final high-end render (Cinema 4D / Octane / Redshift). Final work shipped as the game's official logo <br />
    and appeared in every trailer and ad campaign.</p>
</div>
<div class="space-y-6">
  {images.slice(0, 3).map((img) => (
    <Image src={img} alt="" widths={[400, 800, 1200, 1600]} sizes="100vw" class="w-full h-auto" loading="lazy" />
  ))}
  <div class="aspect-video w-full">
    <iframe
      class="w-full h-full yt-lazy"
      data-src="https://www.youtube.com/embed/4F3N4Lxw4_Y"
      title="YouTube video player"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>
  </div>
</div>

<!-- 섹션 2: Dead Space -->
<div class="mt-16">
  <h2 class="font-serif text-1xl md:text-3xl lg:text-4xl text-white mb-0 leading-[0.9]">
    Game Interface Design — <br /> UX/UI & Visual Branding
  </h2>
  <p class="pt-4 text-[16px] md:text-[18px]"><span class="font-bold">Worked on UX/UI design for [Dead Space] </span>— Creating player flows, interface systems, and visual assets. <br />Also explored logo and branding concepts, developing a cohesive visual language aligned with the project's creative direction.</p>
</div>
<div class="space-y-6">
  {images.slice(3, 7).map((img) => (
    <Image src={img} alt="" widths={[400, 800, 1200, 1600]} sizes="100vw" class="w-full h-auto" loading="lazy" />
  ))}
</div>

<!-- 섹션 3: Microsoft -->
<div class="mt-16">
  <h2 class="font-serif text-1xl md:text-3xl lg:text-4xl text-white mb-0 leading-[0.9]">
    3D Illustration & Motion Design — <br /> Microsoft Experiences
  </h2>
  <p class="pt-4 text-[16px] md:text-[18px]"><span class="font-bold">3D Visual Designer for Bing & Microsoft Ecosystem Products </span>— Designed and produced 3D illustration and <br />motion systems for Bing and Microsoft digital experiences. Led visual development from concept to final render,<br /> creating user-facing content across information, commerce, and interactive product surfaces.</p>
</div>
<div class="space-y-6">
  {images.slice(7, 9).map((img) => (
    <Image src={img} alt="" widths={[400, 800, 1200, 1600]} sizes="100vw" class="w-full h-auto" loading="lazy" />
  ))}
  <div class="flex gap-6 items-center justify-center">
    <Image src={add1} alt="" class="w-1/4 h-auto" loading="lazy" />
    <Image src={add2} alt="" class="w-1/4 h-auto" loading="lazy" />
  </div>
  <Image src={images[9]} alt="" widths={[400, 800, 1200, 1600]} sizes="100vw" class="w-full h-auto" loading="lazy" />
</div>

<!-- 섹션 4: Hello Kitty YouTube -->
<div class="mt-16">
  <h2 class="font-serif text-1xl md:text-3xl lg:text-4xl text-white mb-0 leading-[0.9]">
    Executive Production & Creative Supervision — <br /> Youtube Hello Kitty Super Cute Series
  </h2>
  <p class="pt-4 text-[16px] md:text-[18px]"><span class="font-bold">Executive Producer for a High-Performing YouTube Original Series (1M-5M+ Views per Episode) </span>— <br />Oversaw the end-to-end creative direction of a character IP-based YouTube series, serving as the executive producer on behalf of the IP company. Led cross-functional review and approval across story development, illustration, animation, music, voice-over, and final video production, ensuring brand consistency quality throughout the series. <br /><br /> </p>
</div>
<div class="space-y-6">
  <Image src={more} alt="" widths={[400, 800, 1200, 1600]} sizes="100vw" class="w-full h-auto" loading="lazy" />
  <div class="aspect-video w-full">
    <iframe
      class="w-full h-full yt-lazy"
      data-src="https://www.youtube.com/embed/xNcPN4DWBJQ"
      title="YouTube video player"
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>
  </div>
</div>
</section>


  <script define:vars={{ PASSWORD_HASH }}>
    const STORAGE_KEY = "work02:unlocked";
    const gate = document.getElementById("gate");
    const content = document.getElementById("gate-content");
    const form = document.getElementById("gate-form");
    const input = document.getElementById("gate-input");
    const errorEl = document.getElementById("gate-error");

    const reveal = () => {
      gate.style.display = "none";
      content.hidden = false;
      document.querySelectorAll(".yt-lazy").forEach((iframe) => {
        if (!iframe.src && iframe.dataset.src) {
          iframe.src = iframe.dataset.src;
        }
      });
    };

    const hash = async (text) => {
      const buf = await crypto.subtle.digest(
        "SHA-256",
        new TextEncoder().encode(text),
      );
      return [...new Uint8Array(buf)]
        .map((b) => b.toString(16).padStart(2, "0"))
        .join("");
    };

    if (sessionStorage.getItem(STORAGE_KEY) === "1") {
      reveal();
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorEl.textContent = "";
      const value = input.value;
      if (!value) return;
      const digest = await hash(value);
      if (digest === PASSWORD_HASH) {
        sessionStorage.setItem(STORAGE_KEY, "1");
        reveal();
      } else {
        errorEl.textContent = "Incorrect password.";
        input.value = "";
        input.focus();
      }
    });
  </script>

</Layout>