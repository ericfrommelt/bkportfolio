---
import Layout from "../layouts/Layout.astro";
import Gallery from "../components/Gallery.astro";
import Lightbox from "../components/Lightbox.astro";
import type { ImageMetadata } from "astro";

const all = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/Work1/*.{jpg,JPG,jpeg,png,PNG,gif,GIF,webp}",
  { eager: true },
);

const naturalSort = (a: string, b: string) =>
  a.localeCompare(b, undefined, { numeric: true, sensitivity: "base" });

const images = Object.entries(all)
  .sort(([a], [b]) => naturalSort(a, b))
  .map(([, mod]) => mod.default);

const conceptArts = images.slice(0, 18);
const motionGraphics = images.slice(18, 28);
const etcetera = images.slice(28);
---

<Layout title="Work 01 — Bora Kang" active="work1">
<section class="px-2 max-w-6xl mx-auto pt-2 pb-24 space-y-12">
  <p class="font-sans text-[13px] tracking-normal uppercase text-white/40 mb-2">
    WORK 01: SELECTED 2D / 3D WORKS
  </p>
  <div>
    <div class="flex">
      <h2 class="flex-1 font-serif text-1xl md:text-3xl lg:text-4xl text-white mb-0 leading-[0.9]">
        3D Illustration & <br /> Concept Art.
      </h2>
      <p class="flex-1 pt-4 text-[14px] md:text-[16px] text-right">3D style illustration and motion graphic videos created with C4D, Octane, <br /> Redshift, Procreate, Daz 3D, Z-Brush, and Photoshop. </p>
    </div>
    <div class="mt-4">
      <Gallery images={conceptArts} group="work01" columns={3} />
    </div>
  </div>

  {motionGraphics.length > 0 && (
    <div>
      <div class="flex">
        <h2 class="flex-1 font-serif text-1xl md:text-3xl lg:text-4xl text-white mb-0 leading-[0.9]">
          2D Illustration  <br /> & Motion Graphics.
        </h2>
        <p class="flex-1 pt-4 text-[14px] md:text-[16px] text-right">2D style Illustration and motion graphic videos with different concepts. <br />Created with Procreate, Illustrator , and Photoshop. </p>
      </div>
      <div class="mt-4">
        <Gallery images={motionGraphics} group="work01" columns={3} />
      </div>
    </div>
  )}

  {etcetera.length > 0 && (
    <div>
      <div class="flex">
        <h2 class="flex-1 font-serif text-1xl md:text-3xl lg:text-4xl text-white mb-0 leading-[0.9]">
          Game Promotion: <br/> Visual Textures & Patterns
        </h2>
        <p class="flex-1 pt-4 text-[14px] md:text-[16px] text-right">Texture designs with different concepts and effects. Created with Procreate and Photoshop. Used as the backdrop of promoting games like Apex and Dragon Age. </p>
      </div>
      <div class="mt-4">
        <Gallery images={etcetera} group="work01" columns={3} />
      </div>
    </div>
  )}
  </section>
  <Lightbox />
</Layout>

